# ─────────────────────────── the API ───────────────────────────
#
# The same service the Android app talks to. One backend, two front ends: a
# member who writes an entry on their phone opens the website and it is there,
# because there is nothing to sync.
NEXT_PUBLIC_API_BASE_URL=https://innenflow-backend.onrender.com

# ─────────────────────────── this site ───────────────────────────
#
# The canonical origin. Every absolute URL in the metadata is built from this,
# so a preview deploy does not publish canonicals and Open Graph URLs pointing
# at production — which is how a preview build ends up outranking the real site
# for its own brand name. Set it per environment.
NEXT_PUBLIC_SITE_URL=https://innenflow.app

# ─────────────────────── Firebase (identity only) ───────────────────────
#
# These ship in the JavaScript bundle and are readable by anyone. That is fine
# and it is how Firebase is designed: the config identifies the project, it does
# not authorise anything. What protects the data is that every API request
# carries a signed ID token which the server verifies with the Admin SDK.
#
# Nothing that is actually a secret goes in this file. There is no service
# account key here and there must never be one — that would bypass every
# authorization check in the backend, and NEXT_PUBLIC_ variables are compiled
# into the client bundle.
#
# Copy these from Firebase Console → Project settings → Your apps → Web app.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
